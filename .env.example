# Server-only secrets. Never expose these through Vite/client variables.
XAI_API_KEY=replace_me
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me
# Public HTTPS base URL used to register Telegram webhook.
TELEGRAM_WEBHOOK_URL=https://your-domain.example

# Live XAUUSD/OANDA monitoring
OANDA_API_TOKEN=replace_me
OANDA_ACCOUNT_ID=replace_me
OANDA_INSTRUMENT=XAU_USD
OANDA_API_BASE_URL=https://api-fxpractice.oanda.com

# OpenAI-compatible AI endpoint. Defaults to xAI if AI_API_URL is omitted.
AI_API_URL=https://api.x.ai/v1/chat/completions
AI_API_KEY=replace_me
AI_MODEL=grok-4.5

# Vercel cron protection
CRON_SECRET=replace_with_random_16_plus_characters

# Existing database
DATABASE_URL=replace_me
